# Copy to .env.local and fill in. Never commit .env.local.

# --- Database (MongoDB Atlas free tier or a local MongoDB) ---
MONGODB_URI=mongodb://127.0.0.1:27017/kaporkhoj

# --- Admin login (/admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
# Random string (16+ chars). Signs the admin cookie and salts click IP hashes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Public site URL (SEO metadata, sitemap, scraper user agent) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Scraper ---
# Contact address sent in the scraper's User-Agent so brands can reach you.
SCRAPER_CONTACT=
# Milliseconds between requests to the same brand site (be polite).
SCRAPER_DELAY_MS=2500

# --- Only if Atlas fails locally with "queryTxt ETIMEOUT" (some hotspot/ISP DNS) ---
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
